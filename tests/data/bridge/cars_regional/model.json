    {
      "id": "cars_demand",
      "op": "plus.demand",
      "inputs": {
        "start": "$start",
        "regional": "demand.regional"
      },
      "params": {
        "steps": 3
      }
    },
    {
      "id": "probability",
      "op": "glm.predict",
      "inputs": {
        "model": "potential.model",
        "drivers": "$drivers",
        "landscape": "$start"
      }
    },
    {
      "id": "simulation",
      "op": "control.repeat",
      "inputs": {
        "times": "cars_demand.steps",
        "landscape": "$start"
      },
      "body": {
        "nodes": [
          {
            "id": "allocate",
            "op": "cars.step",
            "inputs": {
              "landscape": "@landscape",
              "probability": "probability.suitability",
              "regional": "cars_demand.regional",
              "step": "@step",
              "seed": "$seed"
            },
            "params": {
              "weights": {
                "1": 1.0,
                "2": 1.0,
                "3": 1.0,
                "4": 1.0,
                "5": 1.0
              },
              "seeds": {
                "1": 0.1,
                "2": 0.1,
                "3": 0.1,
                "4": 0.1,
                "5": 0.1
              },
              "decay": 0.9,
              "step_size": 20,
              "window": 3,
              "max_iter": 500
            }
          }
        ],
        "carry": {
          "landscape": "allocate.landscape"
        },
        "collect": {
          "maps": "allocate.landscape",
          "info": "allocate.info"
        }
      }
    }
  ],
  "outputs": {
    "maps": {
      "from": "simulation.maps"
    },
    "steps": {
      "from": "simulation.info"
    }
  }
