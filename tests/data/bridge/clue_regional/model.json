    {
      "id": "suitability",
      "op": "glm.predict",
      "inputs": {
        "model": "potential.model",
        "drivers": "$drivers",
        "landscape": "$start"
      }
    },
    {
      "id": "rng",
      "op": "rng.r",
      "inputs": {
        "seed": "$seed"
      },
      "note": "R's generator after set.seed(seed)."
    },
    {
      "id": "history",
      "op": "lulcc.history",
      "inputs": {
        "landscape": "$start"
      }
    },
    {
      "id": "simulation",
      "op": "control.repeat",
      "inputs": {
        "times": "demand.steps",
        "landscape": "$start",
        "history": "history.history"
      },
      "body": {
        "nodes": [
          {
            "id": "allocate",
            "op": "lulcc.step",
            "inputs": {
              "landscape": "@landscape",
              "history": "@history",
              "suitability": "suitability.suitability",
              "regional": "demand.regional",
              "step": "@step",
              "rng": "rng.rng"
            },
            "params": {
              "allocation": {
                "method": "clue",
                "jitter": 0.0001,
                "scale": 0.0005,
                "max_iter": 1000,
                "max_diff": 20,
                "mean_diff": 10
              },
              "elasticity": [
                0.3,
                0.3,
                0.3,
                0.3,
                0.3
              ]
            }
          }
        ],
        "carry": {
          "landscape": "allocate.landscape",
          "history": "allocate.history"
        },
        "collect": {
          "maps": "allocate.landscape",
          "info": "allocate.info"
        }
      }
    }
  ],
  "outputs": {
    "maps": {
      "from": "simulation.maps"
    },
    "steps": {
      "from": "simulation.info"
    }
  }
