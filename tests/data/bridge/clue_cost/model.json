      },
      "note": "R's generator after set.seed(seed)."
    },
    {
      "id": "history",
      "op": "lulcc.history",
      "inputs": {
        "landscape": "$start"
      }
    },
    {
      "id": "simulation",
      "op": "control.repeat",
      "inputs": {
        "times": "demand.steps",
        "landscape": "$start",
        "history": "history.history"
      },
      "body": {
        "nodes": [
          {
            "id": "dynamic_0",
            "op": "dynamic.distance_to",
            "inputs": {
              "landscape": "@landscape",
              "cost": "$cost_0"
            },
            "params": {
              "classes": [
                2
              ],
              "layout": {
                "directions": 8,
                "symmetric": true,
                "extent": [
                  436000.0,
                  468000.0,
                  1356000.0,
                  1383000.0
                ],
                "wrap": false
              }
            },
            "note": "The dynamic variable 'cost_built': the accumulated cost from classes [2]."
          },
          {
            "id": "drivers_0",
            "op": "stack.set",
            "inputs": {
              "stack": "$drivers",
              "map": "dynamic_0.distance"
            },
            "params": {
              "name": "cost_built"
            }
          },
          {
            "id": "suitability",
            "op": "glm.predict",
            "inputs": {
              "model": "potential.model",
              "drivers": "drivers_0.stack",
              "landscape": "@landscape"
            }
          },
          {
            "id": "allocate",
            "op": "lulcc.step",
            "inputs": {
              "landscape": "@landscape",
              "history": "@history",
              "suitability": "suitability.suitability",
              "demand": "demand.demand",
              "step": "@step",
              "rng": "rng.rng"
            },
            "params": {
              "allocation": {
                "method": "clue",
                "jitter": 0.0001,
                "scale": 0.0005,
                "max_iter": 1000,
                "max_diff": 20,
                "mean_diff": 10
              },
              "elasticity": [
                0.3,
                0.3,
                0.3,
                0.3,
                0.3
              ]
            }
          }
        ],
        "carry": {
          "landscape": "allocate.landscape",
          "history": "allocate.history"
        },
        "collect": {
          "maps": "allocate.landscape",
          "info": "allocate.info"
        }
      }
    }
  ],
  "outputs": {
    "maps": {
      "from": "simulation.maps"
    },
    "steps": {
      "from": "simulation.info"
