<!--
  Terraflux's Windows installer (WiX 5): terraflux.exe, the Visual C++ and OpenMP runtimes next to it, and GDAL in
  the folder `gdal`, in Program Files\Terraflux; a shortcut in the Start menu and the folder on the PATH (for
  `terraflux run`), with the application's icon; a rule of the Windows firewall that lets the computers of the
  local network reach Terraflux (other computers helping with its runs, found by its beacons; only those given
  its code get in). Built by tools\make-installer.ps1, which stages the files and gives Version, Stage and Icon.
-->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs" xmlns:fw="http://wixtoolset.org/schemas/v4/wxs/firewall">
  <Package
      Name="Terraflux"
      Manufacturer="Terraflux"
      Version="$(var.Version)"
      UpgradeCode="0f5378cc-a4a4-4353-9708-bf645d60075e"
      Scope="perMachine"
      Compressed="yes">
    <SummaryInformation Description="Terraflux $(var.Version): land use and land cover change modelling" />
    <MajorUpgrade DowngradeErrorMessage="A newer Terraflux is installed already." />
    <MediaTemplate EmbedCab="yes" CompressionLevel="high" />

    <Property Id="ARPURLINFOABOUT" Value="https://github.com/sacridini/terraflux" />
    <Icon Id="terraflux.ico" SourceFile="$(var.Icon)" />
    <Property Id="ARPPRODUCTICON" Value="terraflux.ico" />
    <Property Id="ARPNOMODIFY" Value="1" />

    <StandardDirectory Id="ProgramFiles64Folder">
      <Directory Id="INSTALLFOLDER" Name="Terraflux" />
    </StandardDirectory>

    <Feature Id="Main" Title="Terraflux" Level="1">
      <ComponentGroupRef Id="Files" />
      <ComponentRef Id="StartMenu" />
      <ComponentRef Id="OnPath" />
      <ComponentRef Id="Firewall" />
    </Feature>
  </Package>

  <Fragment>
    <!-- every file staged: terraflux.exe, the runtimes, gdal\ (its libraries, data and plugins) -->
    <ComponentGroup Id="Files" Directory="INSTALLFOLDER">
      <Files Include="$(var.Stage)\**" />
    </ComponentGroup>
  </Fragment>

  <Fragment>
    <StandardDirectory Id="ProgramMenuFolder">
      <Component Id="StartMenu">
        <Shortcut
            Id="TerrafluxShortcut"
            Name="Terraflux"
            Description="Land use and land cover change modelling"
            Target="[INSTALLFOLDER]terraflux.exe"
            Icon="terraflux.ico"
            WorkingDirectory="INSTALLFOLDER" />
        <RegistryValue Root="HKLM" Key="Software\Terraflux" Name="StartMenu" Type="integer" Value="1" KeyPath="yes" />
      </Component>
    </StandardDirectory>
  </Fragment>

  <Fragment>
    <!-- the local network only: the computers that help, and the beacons they find each other by -->
    <Component Id="Firewall" Directory="INSTALLFOLDER" Guid="3d0f5bb4-6d1e-4c1f-9f3b-2a7c7f0d9e51">
      <fw:FirewallException Id="TerrafluxNetwork" Name="Terraflux (computers of the local network)"
                            Program="[INSTALLFOLDER]terraflux.exe" Scope="localSubnet" IgnoreFailure="yes" />
      <RegistryValue Root="HKLM" Key="Software\Terraflux" Name="Firewall" Type="integer" Value="1" KeyPath="yes" />
    </Component>
  </Fragment>

  <Fragment>
    <Component Id="OnPath" Directory="INSTALLFOLDER" Guid="f5cb610b-88a3-4424-bd7c-6660b99bb948">
      <Environment Id="TerrafluxPath" Name="PATH" Value="[INSTALLFOLDER]" Part="last" Action="set" System="yes"
                   Permanent="no" />
      <RegistryValue Root="HKLM" Key="Software\Terraflux" Name="OnPath" Type="integer" Value="1" KeyPath="yes" />
    </Component>
  </Fragment>
</Wix>
