<!--
  Terraflux's Windows installer (WiX 5): terraflux.exe, the Visual C++ and OpenMP runtimes next to it, and GDAL in
  the folder `gdal`, for the user installing it, with no administrator's permission asked (installed and removed
  without Windows' prompt): in %LOCALAPPDATA%\Programs\Terraflux, a shortcut in the user's Start menu and the folder
  on the user's PATH (for `terraflux run`), with the application's icon. Windows' firewall asks, the first time,
  only when Terraflux is opened to the computers of the local network (other computers helping with its runs).
  Its pages: the progress, then the end, which says Terraflux is installed and opens it (left ticked). Built by
  tools\make-installer.ps1, which stages the files and gives Version, Stage, Icon and the pages' pictures (Dialog,
  Banner).
-->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
  <Package
      Name="Terraflux"
      Manufacturer="Terraflux"
      Version="$(var.Version)"
      UpgradeCode="0f5378cc-a4a4-4353-9708-bf645d60075e"
      Scope="perUser"
      Compressed="yes">
    <SummaryInformation Description="Terraflux $(var.Version): land use and land cover change modelling" />
    <MajorUpgrade DowngradeErrorMessage="A newer Terraflux is installed already." />
    <MediaTemplate EmbedCab="yes" CompressionLevel="high" />

    <Property Id="ARPURLINFOABOUT" Value="https://github.com/sacridini/terraflux" />
    <Icon Id="terraflux.ico" SourceFile="$(var.Icon)" />
    <Property Id="ARPPRODUCTICON" Value="terraflux.ico" />
    <Property Id="ARPNOMODIFY" Value="1" />
    <!-- no restore point of Windows before installing or removing (a snapshot of the disk by the shadow copy
         service, a minute in which the whole computer stalls): Terraflux changes nothing of the system -->
    <Property Id="MSIFASTINSTALL" Value="1" />

    <!-- the pages: the progress, then the end (Terraflux installed, opened at once when left ticked); no page to
         answer before it installs. Removing it (Settings, Apps) and the updates (msiexec /passive) show only the
         progress. -->
    <UI Id="TerrafluxUI">
      <TextStyle Id="WixUI_Font_Normal" FaceName="Segoe UI" Size="9" />
      <TextStyle Id="WixUI_Font_Bigger" FaceName="Segoe UI" Size="12" />
      <TextStyle Id="WixUI_Font_Title" FaceName="Segoe UI" Size="9" Bold="yes" />
      <Property Id="DefaultUIFont" Value="WixUI_Font_Normal" />
      <DialogRef Id="ErrorDlg" />
      <DialogRef Id="FatalError" />
      <DialogRef Id="FilesInUse" />
      <DialogRef Id="MsiRMFilesInUse" />
      <DialogRef Id="PrepareDlg" />
      <DialogRef Id="ProgressDlg" />
      <DialogRef Id="ResumeDlg" />
      <DialogRef Id="UserExit" />
      <Publish Dialog="ExitDialog" Control="Finish" Event="DoAction" Value="OpenTerraflux"
               Condition="WIXUI_EXITDIALOGOPTIONALCHECKBOX = 1 and NOT Installed" />
      <Publish Dialog="ExitDialog" Control="Finish" Event="EndDialog" Value="Return" Order="999" />
    </UI>
    <UIRef Id="WixUI_Common" />
    <WixVariable Id="WixUIDialogBmp" Value="$(var.Dialog)" />
    <WixVariable Id="WixUIBannerBmp" Value="$(var.Banner)" />
    <Property Id="WIXUI_EXITDIALOGOPTIONALTEXT"
              Value="Terraflux $(var.Version) is installed: in the Start menu, and the command terraflux in a new terminal. It updates itself from now on." />
    <Property Id="WIXUI_EXITDIALOGOPTIONALCHECKBOXTEXT" Value="Open Terraflux" />
    <Property Id="WIXUI_EXITDIALOGOPTIONALCHECKBOX" Value="1" />
    <SetProperty Id="WixShellExecTarget" Value="[INSTALLFOLDER]terraflux.exe" After="CostFinalize" Sequence="ui" />
    <CustomAction Id="OpenTerraflux" BinaryRef="Wix4UtilCA_X64" DllEntry="WixShellExec" Impersonate="yes" />

    <!-- a Terraflux installed for all the users (the installers before 1.18): its folder on the PATH of the
         system, before the user's, would run in place of this one; removed first (the administrator's prompt of
         that installer, once) -->
    <Property Id="FORALLUSERS">
      <RegistrySearch Root="HKLM" Key="Software\Terraflux" Name="StartMenu" Type="raw" Bitness="always64" />
    </Property>
    <Launch Condition="Installed OR NOT FORALLUSERS"
            Message="A Terraflux installed for all the users of this computer (by an installer before 1.18) is here. Remove it first in Settings, Apps (Windows asks the administrator one last time), then run this installer again: it installs Terraflux for you, without the administrator." />

    <StandardDirectory Id="LocalAppDataFolder">
      <Directory Id="ProgramsFolder" Name="Programs">
        <Directory Id="INSTALLFOLDER" Name="Terraflux" />
      </Directory>
    </StandardDirectory>

    <Feature Id="Main" Title="Terraflux" Level="1">
      <ComponentGroupRef Id="Files" />
      <ComponentRef Id="StartMenu" />
      <ComponentRef Id="OnPath" />
    </Feature>
  </Package>

  <Fragment>
    <!-- every file staged: terraflux.exe, the runtimes, gdal\ (its libraries, data and plugins) -->
    <ComponentGroup Id="Files" Directory="INSTALLFOLDER">
      <Files Include="$(var.Stage)\**" />
    </ComponentGroup>
  </Fragment>

  <Fragment>
    <StandardDirectory Id="ProgramMenuFolder">
      <Component Id="StartMenu">
        <Shortcut
            Id="TerrafluxShortcut"
            Name="Terraflux"
            Description="Land use and land cover change modelling"
            Target="[INSTALLFOLDER]terraflux.exe"
            Icon="terraflux.ico"
            WorkingDirectory="INSTALLFOLDER" />
        <RegistryValue Root="HKCU" Key="Software\Terraflux" Name="StartMenu" Type="integer" Value="1" KeyPath="yes" />
      </Component>
    </StandardDirectory>
  </Fragment>

  <Fragment>
    <Component Id="OnPath" Directory="INSTALLFOLDER" Guid="bbb25644-6b2b-476b-8aba-7ec0d7c5c4ef">
      <Environment Id="TerrafluxPath" Name="PATH" Value="[INSTALLFOLDER]" Part="last" Action="set" System="no"
                   Permanent="no" />
      <RegistryValue Root="HKCU" Key="Software\Terraflux" Name="OnPath" Type="integer" Value="1" KeyPath="yes" />
      <!-- the folders made in the user's profile, removed with Terraflux -->
      <RemoveFolder Id="RemoveInstallFolder" Directory="INSTALLFOLDER" On="uninstall" />
      <RemoveFolder Id="RemoveProgramsFolder" Directory="ProgramsFolder" On="uninstall" />
    </Component>
  </Fragment>
</Wix>
